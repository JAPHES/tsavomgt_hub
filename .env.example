# Sensitive values are intentionally blank. Set them only in an ignored .env
# file for local work or in the deployment platform's secret manager.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Render supplies this automatically; it is also accepted as an allowed host.
RENDER_EXTERNAL_HOSTNAME=
DATABASE_URL=sqlite:///db.sqlite3
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Tsavo Innovation & Incubation Hub <noreply@secora.dev>
SUPPORT_EMAIL=
ASSISTANT_SUPPORT_EMAIL=
SUPPORT_PHONE=
SITE_URL=http://127.0.0.1:8000
PASSWORD_RESET_TIMEOUT=3600

# Optional production hardening and branding values
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=
SITE_LOGO_URL=
STATIC_VERSION=20260903.1
TRUST_PROXY_SSL_HEADER=False
# Use Cloudinary in production; leave blank for local filesystem storage.
CLOUDINARY_URL=
# Optional one-time deployment bootstrap. Remove both values after first login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Hub
INITIAL_ADMIN_LAST_NAME=Administrator
# Set this to a persistent-disk mount or external-media path in production.
MEDIA_ROOT=
