# Sensitive values are intentionally blank. Set them only in an ignored .env
# file for local work or in the deployment platform's secret manager.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tsavo Hub <noreply@example.com>
PASSWORD_RESET_TIMEOUT=3600

# Optional production hardening and branding values
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=
SITE_LOGO_URL=
STATIC_VERSION=20260821.2
TRUST_PROXY_SSL_HEADER=False
